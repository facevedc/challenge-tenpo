{
  "info": {
    "_postman_id": "de4c80fe-2fa1-4e77-a3bb-d26c95dba3d4",
    "name": "challenge-tenpo-local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion local para probar la API del challenge Tenpo, el mock externo y los escenarios por header."
  },
  "item": [
    {
      "name": "Soporte",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('status UP', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        },
        {
          "name": "Reiniciar escenarios mock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reset mock responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{mockBaseUrl}}/__admin/scenarios/reset",
              "host": [
                "{{mockBaseUrl}}"
              ],
              "path": [
                "__admin",
                "scenarios",
                "reset"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Escenarios Calculo",
      "item": [
        {
          "name": "Flujo Exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('flujo exitoso responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('resultado esperado del flujo exitoso', function () {",
                  "    pm.expect(json.num1).to.eql(5);",
                  "    pm.expect(json.num2).to.eql(7);",
                  "    pm.expect(json.base_sum).to.eql(12);",
                  "    pm.expect(json.percentage).to.eql(10);",
                  "    pm.expect(json.final_amount).to.eql(13.2);",
                  "    pm.expect(json.percentage_source).to.eql('external-mock');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Mock-Scenario",
                "value": "success",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calculations?num1={{num1}}&num2={{num2}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calculations"
              ],
              "query": [
                {
                  "key": "num1",
                  "value": "{{num1}}"
                },
                {
                  "key": "num2",
                  "value": "{{num2}}"
                }
              ]
            }
          }
        },
        {
          "name": "Retry Exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('retry exitoso responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('retry termina usando fuente externa', function () {",
                  "    pm.expect(json.percentage_source).to.eql('external-mock');",
                  "    pm.expect(json.percentage).to.eql(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Mock-Scenario",
                "value": "retry-success",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calculations?num1={{num1}}&num2={{num2}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
