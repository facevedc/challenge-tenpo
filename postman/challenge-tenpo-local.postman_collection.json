        },
        {
          "name": "Fallback Con Cache",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('fallback con cache responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('fallback usa redis-cache', function () {",
                  "    pm.expect(json.percentage_source).to.eql('redis-cache');",
                  "    pm.expect(json.percentage).to.eql(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Mock-Scenario",
                "value": "error",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calculations?num1={{num1}}&num2={{num2}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calculations"
              ],
              "query": [
                {
                  "key": "num1",
                  "value": "{{num1}}"
                },
                {
                  "key": "num2",
                  "value": "{{num2}}"
                }
              ]
            }
          }
        },
        {
          "name": "Fallback Sin Cache",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('fallback sin cache responde 503', function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "",
                  "pm.test('mensaje esperado sin cache previa', function () {",
                  "    pm.expect(json.code).to.eql('SERVICE_UNAVAILABLE');",
                  "    pm.expect(json.message).to.eql('Percentage service unavailable and no cached value found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Mock-Scenario",
                "value": "error",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calculations?num1={{num1}}&num2={{num2}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calculations"
              ],
              "query": [
                {
                  "key": "num1",
                  "value": "{{num1}}"
                },
                {
                  "key": "num2",
                  "value": "{{num2}}"
                }
              ]
            },
            "description": "Antes de ejecutar este request, limpia Redis con ./scripts/reset_percentage_cache.sh"
          }
        }
      ]
    }
